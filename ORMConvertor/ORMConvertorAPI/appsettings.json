{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "translation": {
        "ClusterId": "translation",
        "Match": {
          "Path": "/api/convert"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "metadata-required": {
        "ClusterId": "metadata",
        "Match": {
          "Path": "/api/required-content"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "metadata-required-advisor": {
        "ClusterId": "metadata",
        "Match": {
          "Path": "/api/required-content-advisor"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "metadata-samples": {
        "ClusterId": "metadata",
        "Match": {
          "Path": "/api/samples"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "advisor-test": {
        "ClusterId": "advisor",
        "Match": {
          "Path": "/api/advisor/test"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "advisor-run": {
        "ClusterId": "advisor",
        "Match": {
          "Path": "/api/advisor/run"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "translation": {
        "Destinations": {
          "primary": {
            "Address": "http://translation-service:8080"
          }
        }
      },
      "metadata": {
        "Destinations": {
          "primary": {
            "Address": "http://metadata-service:8080"
          }
        }
      },
      "advisor": {
        "Destinations": {
          "primary": {
            "Address": "http://advisor-service:8080"
          }
        }
      }
    }
  }
}
